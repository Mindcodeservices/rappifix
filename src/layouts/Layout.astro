---
import "@fontsource-variable/plus-jakarta-sans";
import "../styles/global.css";

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth scroll-pt-24">
	<head>
		<meta charset="UTF-8" />
		<script is:inline>document.documentElement.classList.add("js");</script>
		<meta
			name="description"
			content="Contactiza - Soluciones rápidas y confiables para tareas del hogar. Desde plomería hasta reparaciones eléctricas, estamos aquí para ayudarte."
		/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#090d4e" />
		<!-- Título optimizado con palabras clave -->
		<title>{title}</title>
		<!-- Open Graph meta tags para redes sociales -->
		<meta
			property="og:title"
			content="Contactiza | Soluciones rápidas para tus tareas del hogar"
		/>
		<meta
			property="og:description"
			content="Confía en Contactiza para resolver tus necesidades de plomería, electricidad, y más. Personal especializado disponible 24/7 para ayudarte."
		/>
		<meta
			property="og:image"
			content="https://contactiza.com/contactiza.png?v=2"
		/>
		<meta property="og:url" content="https://contactiza.com" />
		<meta property="og:type" content="website" />
		<!-- Twitter Card meta tags -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta
			name="twitter:title"
			content="Contactiza | Soluciones rápidas para tus tareas del hogar"
		/>
		<meta
			name="twitter:description"
			content="Confía en Contactiza para resolver tus necesidades de plomería, electricidad, y más. Personal especializado disponible 24/7 para ayudarte."
		/>
		<meta
			name="twitter:image"
			content="https://contactiza.com/contactiza.png?v=2"
		/>
		<!-- Favicon -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<!-- Canonical URL -->
		<link rel="canonical" href="https://contactiza.com" />
		<!-- Meta Robots -->
		<meta name="robots" content="index, follow" />
		<!-- Meta Keywords -->
		<meta
			name="keywords"
			content="Contactiza, tareas del hogar, plomería, electricidad, reparaciones, servicios domésticos"
		/>
		<!-- Datos estructurados para SEO (Schema.org) -->
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "Organization",
				"name": "Contactiza",
				"url": "https://contactiza.com",
				"logo": "https://contactiza.com/contactiza.png",
				"contactPoint": {
					"@type": "ContactPoint",
					"telephone": "+507-6770-2618",
					"contactType": "Customer Service",
					"areaServed": "Panama",
					"availableLanguage": ["Spanish", "English"]
				},
				"sameAs": [
					"https://www.facebook.com/contactiza",
					"https://www.instagram.com/contactiza"
				]
			}
		</script>
	</head>
	<body>
		<slot />
		<script>
			// data-reveal: aparece una sola vez. data-loop: anima solo mientras está en pantalla.
			const observer = new IntersectionObserver(
				(entries) => {
					for (const { target, isIntersecting } of entries) {
						const loops = target.hasAttribute("data-loop");
						if (isIntersecting) target.classList.add("is-in");
						if (loops) target.classList.toggle("is-looping", isIntersecting);
						else if (isIntersecting) observer.unobserve(target);
					}
				},
				{ threshold: 0.15 },
			);

			document
				.querySelectorAll("[data-reveal], [data-loop]")
				.forEach((el) => observer.observe(el));
		</script>
	</body>
</html>
