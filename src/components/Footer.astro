---
const links = [
  { href: "#home", label: "Inicio" },
  { href: "#service", label: "Servicios" },
  { href: "#how", label: "Cómo funciona" },
  { href: "#social", label: "Sobre nosotros" },
];
---

<footer class="border-t border-line">
  <div class="mx-auto flex max-w-7xl flex-col items-center gap-6 px-6 pt-10 pb-24 lg:flex-row lg:justify-between lg:px-8">
    <img class="h-6 w-auto" src="/contactiza.png" alt="Contactiza" width="393" height="57" loading="lazy" />
    <nav class="flex flex-wrap justify-center gap-x-8 gap-y-2 text-sm font-medium" aria-label="Pie de página">
      {
        links.map(({ href, label }) => (
          <a href={href} class="text-muted transition-colors hover:text-navy">
            {label}
          </a>
        ))
      }
    </nav>
    <p class="text-center text-sm text-muted">
      &copy; {new Date().getFullYear()} Contactiza, Inc. Todos los derechos reservados.
    </p>
  </div>
</footer>
