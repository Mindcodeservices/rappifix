---
import WhatsAppIcon from "./WhatsAppIcon.astro";
import { waLink } from "../lib/whatsapp";

const links = [
  { href: "#service", label: "Servicios" },
  { href: "#how", label: "¿Cómo funciona?" },
  { href: "#social", label: "Sobre nosotros" },
];
const quoteUrl = waLink("Hola quiero una cotizacion");
---

<header class="sticky top-0 z-40">
  <div class="border-b border-line/70 bg-white/80 backdrop-blur-md">
    <nav
      class="mx-auto flex h-18 max-w-7xl items-center justify-between px-6 lg:px-8"
      aria-label="Global"
    >
      <a href="#home" class="rounded-sm">
        <img class="h-7 w-auto" src="/contactiza.png" alt="Contactiza" width="393" height="57" />
      </a>
      <div class="hidden items-center gap-x-9 lg:flex">
        {
          links.map(({ href, label }) => (
            <a href={href} class="text-sm font-semibold text-muted transition-colors hover:text-navy">
              {label}
            </a>
          ))
        }
      </div>
      <a href={quoteUrl} target="_blank" rel="noopener" class="btn-primary hidden px-5 py-2.5 text-sm lg:inline-flex">
        <WhatsAppIcon class="size-4" />
        Pide un presupuesto
      </a>
      <button
        type="button"
        id="menuOpen"
        aria-haspopup="dialog"
        aria-controls="mobileMenu"
        class="-mr-2 rounded-lg p-2 text-navy lg:hidden"
      >
        <span class="sr-only">Abrir menú</span>
        <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </nav>
  </div>

  <dialog id="mobileMenu" aria-label="Menú" class="m-0 ml-auto h-dvh max-h-none w-full max-w-sm bg-white text-navy">
    <div class="flex h-full flex-col p-6">
      <div class="flex items-center justify-between">
        <img class="h-7 w-auto" src="/contactiza.png" alt="Contactiza" width="393" height="57" />
        <button type="button" id="menuClose" class="-mr-2 rounded-lg p-2">
          <span class="sr-only">Cerrar menú</span>
          <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <div class="mt-8 flex flex-col gap-1">
        {
          [{ href: "#home", label: "Inicio" }, ...links].map(({ href, label }) => (
            <a href={href} class="rounded-xl px-3 py-3 text-lg font-semibold hover:bg-surface">
              {label}
            </a>
          ))
        }
      </div>
      <a href={quoteUrl} target="_blank" rel="noopener" class="btn-primary mt-auto">
        <WhatsAppIcon />
        Pide un presupuesto
      </a>
    </div>
  </dialog>
</header>

<script>
  const menu = document.getElementById("mobileMenu") as HTMLDialogElement;

  document.getElementById("menuOpen")?.addEventListener("click", () => menu.showModal());
  document.getElementById("menuClose")?.addEventListener("click", () => menu.close());

  // Cierra al tocar un enlace o el fondo.
  menu.addEventListener("click", (event) => {
    const target = event.target as Element;
    if (target === menu || target.closest("a")) menu.close();
  });

  // Evita que quede abierto al pasar a escritorio.
  window.matchMedia("(min-width: 64rem)").addEventListener("change", () => menu.close());
</script>
