---
const steps = [
  { title: "Describe tu necesidad", text: "Cuéntanos al WhatsApp" },
  { title: "Atendemos tus requerimientos", text: "Siempre a tu disposición 24/7" },
  { title: "Personal técnico", text: "Asignamos al mejor" },
];
---

<section id="how" class="bg-surface py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="max-w-3xl" data-reveal>
      <h2 class="section-title">
        ¿Cómo funciona <span class="text-action">Contactiza</span>?
      </h2>
      <p class="mt-5 text-lg/8 text-muted">
        Pide cualquier servicio que necesites en <span class="font-bold text-action-dark">3 pasos</span>
      </p>
    </div>
    <ol class="relative mt-12 grid gap-10 lg:mt-16 lg:grid-cols-3 lg:gap-8" data-reveal>
      <li
        role="presentation"
        class="step-line absolute top-6 bottom-6 left-6 w-0.5 -translate-x-1/2 bg-action lg:right-[calc((100%-4rem)/3-1.5rem)]lg:bottom-auto lg:h-0.5 lg:w-auto lg:translate-x-0"
      >
      </li>
      {
        steps.map(({ title, text }, index) => (
          <li class="relative flex items-start gap-5 lg:flex-col">
            <span class="flex size-12 shrink-0 items-center justify-center rounded-full bg-navy text-lg font-bold text-white ring-8 ring-surface">
              {index + 1}
            </span>
            <div>
              <h3 class="text-xl font-bold tracking-tight">{title}</h3>
              <p class="mt-1.5 text-base text-muted">{text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
