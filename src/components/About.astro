---
import WhatsAppIcon from "./WhatsAppIcon.astro";
import { waLink } from "../lib/whatsapp";
---

<section id="social" class="px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
  <div
    class="relative isolate mx-auto max-w-7xl overflow-hidden rounded-[2rem] bg-navy px-6 py-16 text-center sm:px-12 lg:py-24"
    data-reveal
  >
    <div class="absolute -top-32 left-1/2 -z-10 size-96 -translate-x-1/2 rounded-full bg-action/35 blur-3xl"></div>
    <h2 class="mx-auto max-w-3xl text-4xl font-bold tracking-[-0.025em] text-balance text-white sm:text-5xl">
      Realiza todas las tareas del hogar con <span class="text-coral">Contactiza</span>.
    </h2>
    <p class="mx-auto mt-6 max-w-xl text-lg/8 text-pretty text-white/80">
      Desde pequeñas reparaciones hasta grandes proyectos, nuestro equipo está
      listo para ayudarte de manera rápida y confiable. Describe tu necesidad y
      recibe asistencia profesional hoy mismo.
    </p>
    <a
      href={waLink("Hola quiero una cotización")}
      target="_blank"
      rel="noopener"
      class="btn-primary mt-10 focus-visible:outline-white"
    >
      <WhatsAppIcon />
      Contáctanos Hoy Mismo
    </a>
  </div>
</section>
