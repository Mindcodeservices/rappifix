---
const services = ["Plomería", "Electricidad", "Muebles", "Pintura y más"];
---

<!-- Ilustración del flujo por WhatsApp: decorativa, no es una conversación real. -->
<div
  class="relative isolate overflow-hidden rounded-[2rem] bg-navy p-5 sm:p-8"
  aria-hidden="true"
>
  <div class="absolute -top-24 -right-24 -z-10 size-80 rounded-full bg-action/40 blur-3xl"></div>
  <div class="absolute -bottom-32 -left-20 -z-10 size-80 rounded-full bg-navy-700 blur-3xl"></div>

  <div class="mx-auto max-w-sm rounded-3xl bg-white p-4 shadow-2xl shadow-black/30">
    <div class="flex items-center gap-3 border-b border-line pb-3">
      <img class="size-9" src="/favicon.svg" alt="" width="36" height="36" />
      <div>
        <p class="text-sm font-bold">Contactiza</p>
        <p class="flex items-center gap-1.5 text-xs text-muted">
          <span class="status-dot size-1.5 rounded-full bg-whatsapp"></span>
          Disponible 24/7
        </p>
      </div>
    </div>

    <div class="flex flex-col gap-2.5 pt-4">
      <p class="chat-bubble chat-bubble--user chat-step chat-step--1">
        Hola, quiero reparar un daño
      </p>
      <div class="chat-slot">
        <p class="chat-bubble chat-bubble--agent chat-step chat-step--2 justify-self-start">
          ¡Hola! Cuéntanos qué necesitas.
        </p>
        <div class="chat-typing chat-typing--1"><i></i><i></i><i></i></div>
      </div>
      <p class="chat-bubble chat-bubble--user chat-step chat-step--3">
        Una fuga en el lavamanos
      </p>
      <div class="chat-slot">
        <p class="chat-bubble chat-bubble--agent chat-step chat-step--4 justify-self-start">
          Listo, asignamos al mejor técnico para ti.
        </p>
        <div class="chat-typing chat-typing--2"><i></i><i></i><i></i></div>
      </div>
      <div class="chat-step chat-step--5 mt-1 flex items-center gap-2.5 rounded-2xl border border-line p-3">
        <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-whatsapp/15 text-[#0b7a3b]">
          <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <path d="m5 13 4 4L19 7"></path>
          </svg>
        </span>
        <span class="text-sm font-semibold">Personal técnico asignado</span>
      </div>
    </div>
  </div>

  <ul class="mt-5 flex flex-wrap justify-center gap-2 sm:mt-6">
    {
      services.map((service, index) => (
        <li
          class="float-pill rounded-full border border-white/20 bg-white/10 px-3 py-1.5 text-xs font-semibold text-white"
          style={`--delay: ${index * -1200}ms`}
        >
          {service}
        </li>
      ))
    }
  </ul>
</div>
